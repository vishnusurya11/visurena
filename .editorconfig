root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows shell scripts must keep CRLF
[*.{ps1,bat,cmd}]
end_of_line = crlf

# Don't trim trailing whitespace in Markdown (two trailing spaces = hard break)
[*.md]
trim_trailing_whitespace = false
