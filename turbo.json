{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["out/**", ".next/**", "dist/**"], "env": ["VR_CONTENT_SOURCE", "VR_CONTENT_S3_BUCKET", "VR_CONTENT_S3_REGION", "VR_CONTENT_LOCAL_DIR"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
